# Environment
ENVIRONMENT=production

# Server Configuration
HOST=0.0.0.0
PORT=443
RELOAD=false

# Let's Encrypt / Certbot Configuration
CERTBOT_ENABLED=true
DOMAIN=hoangtv.io.vn
EMAIL=admin@hoangtv.io.vn

# SSL/TLS Certificate Paths (Let's Encrypt default path)
SSL_KEYFILE=/etc/letsencrypt/live/hoangtv.io.vn/privkey.pem
SSL_CERTFILE=/etc/letsencrypt/live/hoangtv.io.vn/fullchain.pem
