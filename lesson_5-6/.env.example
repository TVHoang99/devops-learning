# Environment: 'local' or 'production'
ENVIRONMENT=local

# Server Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=true

# Let's Encrypt / Certbot Configuration (Production only)
CERTBOT_ENABLED=false
DOMAIN=yourdomain.com
EMAIL=your-email@example.com

# SSL/TLS Certificate Paths
SSL_KEYFILE=/fasiapi/certs/key.pem
SSL_CERTFILE=/fasiapi/certs/cert.pem
